    "familos-mailcraft": {
      "build": {
        "context": "./apps/familos/extras/artcraft",
        "dockerfile": "Dockerfile.mailcraft",
        "args": {
          "UPSTREAM_SHA": "${FAMILOS_MAILCRAFT_SHA:-}"
        },
        "secrets": [
          {
            "source": "familos_gh_token",
            "target": "gh_token"
          }
        ]
      },
      "image": "orbita-familos-mailcraft:local",
      "profiles": [
        "familos-mailcraft"
      ],
      "restart": "unless-stopped",
      "environment": [
        "MAILCRAFT_TOKEN=${FAMILOS_MAILCRAFT_TOKEN:-}",
        "MAILCRAFT_LANG=it",
        "MCP_PORT=7889",
        "MAILCRAFT_GOOGLE_CLIENT_ID=${FAMILOS_MAILCRAFT_GOOGLE_CLIENT_ID:-}",
        "MAILCRAFT_GOOGLE_CLIENT_SECRET=${FAMILOS_MAILCRAFT_GOOGLE_CLIENT_SECRET:-}",
        "MAILCRAFT_MICROSOFT_CLIENT_ID=${FAMILOS_MAILCRAFT_MICROSOFT_CLIENT_ID:-}",
        "MAILCRAFT_MICROSOFT_CLIENT_SECRET=${FAMILOS_MAILCRAFT_MICROSOFT_CLIENT_SECRET:-}",
        "MAILCRAFT_PUBLIC_URL=${FAMILOS_MAILCRAFT_PUBLIC_URL:-}"
      ],
      "volumes": [
        "./apps/familos/private/mailcraft:/mail",
        "./apps/familos/data:/data:ro",
        "./apps/familos/data/mailcraft:/data/mailcraft"
      ],
      "expose": [
        "7878",
        "7889"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "1m",
          "max-file": "1"
        }
      },
      "networks": {
        "familos": {
          "aliases": [
            "mailcraft"
          ]
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "stop_grace_period": "90s"
    }
  },
  "secrets": {
    "familos_gh_token": {
      "file": "./apps/familos/private/github-token"
    }
  }
}
