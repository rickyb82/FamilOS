{
  "apps": [
    "wordcraft",
    "gridcraft",
    "pdfcraft",
    "deckcraft",
    "ideacraft",
    "mailcraft"
  ],
  "services": {
    "familos-wordcraft": {
      "build": {
        "context": "./apps/familos/extras/artcraft",
        "dockerfile": "Dockerfile.cli",
        "args": {
          "APP": "wordcraft",
          "UPSTREAM_SHA": "${FAMILOS_WORDCRAFT_SHA:-}"
        },
        "secrets": [
          {
            "source": "familos_gh_token",
            "target": "gh_token"
          }
        ]
      },
      "image": "orbita-familos-wordcraft:local",
      "profiles": [
        "familos-wordcraft"
      ],
      "restart": "unless-stopped",
      "environment": [
        "MCP_PORT=7982",
        "MCP_ARGS=--author FamilAI --automation-read-root /data --automation-write-root /data/wordcraft"
      ],
      "volumes": [
        "./apps/familos/data:/data"
      ],
      "expose": [
        "7982"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "1m",
          "max-file": "1"
        }
      },
      "networks": {
        "familos": {
          "aliases": [
            "wordcraft"
          ]
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "familos-wordcraft-web": {
      "build": {
        "context": "./apps/familos/extras/artcraft",
        "dockerfile": "Dockerfile.web",
        "args": {
          "APP": "wordcraft",
          "UPSTREAM_SHA": "${FAMILOS_WORDCRAFT_SHA:-}"
        },
        "secrets": [
          {
            "source": "familos_gh_token",
            "target": "gh_token"
          }
        ]
      },
      "image": "orbita-familos-wordcraft-web:local",
      "profiles": [
        "familos-wordcraft"
      ],
      "restart": "unless-stopped",
      "expose": [
        "80"
      ],
      "networks": {
        "familos": {
          "aliases": [
            "wordcraft-web"
          ]
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
