# FamilOS — famiglia, produttività, OpenAI e Ollama
BRAND_NAME=FamilOS
PUBLIC_HOST=localhost
EXTRA_HOSTS=
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443
TLS_MODE=acme
ACME_STAGING=false
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

SECRET_KEY=change-me-before-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-production
ADMIN_NAME=Admin
FAMILY_NAME=Famiglia
COOKIE_SECURE=true
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=FamilOS
WEBAUTHN_ORIGIN=https://localhost
REQUIRE_MFA_FOR_ADULTS=true
MFA_OPTIONAL=1
PASSKEYS=1

# Solo due provider. Le chiavi possono essere impostate anche dal pannello Famiglia.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-6-luna
OPENAI_CACHE_MODE=auto
OLLAMA_URL=
OLLAMA_DEFAULT_MODEL=qwen3:8b
# Per Docker: http://host.docker.internal:11434 (Mac) oppure http://ollama:11434.
# COMPOSE_PROFILES=ollama avvia un server locale nel progetto.
COMPOSE_PROFILES=
ENABLE_MOCK_PROVIDER=false

# Documenti e memoria: Ollama locale oppure OpenAI; nessun altro provider.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
MEMORY_ENABLED=true
MEMORY_AUTO_APPROVE=false
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-2.5-flare
TTS_PROVIDER=auto
TTS_MODEL_OPENAI=gpt-4o-mini-tts
TTS_VOICE_OPENAI=nova
WEB_SEARCH_PROVIDER=auto
SEARXNG_URL=http://searxng:8080

# Gestite automaticamente da ./familos.sh productivity up.
WORDCRAFT_HOST=
WORDCRAFT_WEB=0
GRIDCRAFT_HOST=
GRIDCRAFT_WEB=0
PDFCRAFT_HOST=
PDFCRAFT_WEB=0
DECKCRAFT_HOST=
DECKCRAFT_WEB=0
IDEACRAFT_HOST=
IDEACRAFT_WEB=0
MAILCRAFT_URL=
MAILCRAFT_MCP_HOST=
MAILCRAFT_TOKEN=

# Email di sistema per inviti e recupero password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=FamilOS
SMTP_SECURITY=starttls
MAIL_TRANSPORT=auto

# Notifiche push; il pannello genera le chiavi quando abilitate.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Chiamate in Messaggi (TURN opzionale; non sono strumenti per operatori di rete).
TURN_URLS=
TURN_SECRET=
STUN_URLS=
